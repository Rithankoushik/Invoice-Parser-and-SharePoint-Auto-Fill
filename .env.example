# Azure / SharePoint Configuration
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id#Add a certificate or secret
AZURE_CLIENT_SECRET=your-client-secret

# SharePoint List Details
# To get Site ID: GET https://graph.microsoft.com/v1.0/sites/{hostname}:/sites/{site-name}
# To get List ID: GET https://graph.microsoft.com/v1.0/sites/{site-id}/lists
SHAREPOINT_SITE_ID=your-sharepoint-site-id
SHAREPOINT_LIST_ID=your-sharepoint-list-id

# LLM Configuration
MODEL_NAME=google/flan-t5-base
MAX_NEW_TOKENS=512

# OCR Configuration (Optional - only if not in PATH)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\path\to\poppler\bin
